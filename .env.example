# EmailJS credentials for the contact form.
# Sign up at https://www.emailjs.com/ (free tier), connect Gmail, create a service + template.
# All 3 values come from your EmailJS dashboard. Vite requires the VITE_ prefix to expose them.
#
# Where to find each:
#   VITE_EMAILJS_SERVICE_ID   → Dashboard → Email Services → your service → Service ID
#   VITE_EMAILJS_TEMPLATE_ID  → Dashboard → Email Templates → your template → Template ID
#   VITE_EMAILJS_PUBLIC_KEY   → Dashboard → Account → General → Public Key

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Groq API key for the AI chat assistant.
# Sign up at https://console.groq.com/, create a key under "API Keys".
# NO "VITE_" prefix on purpose — this is server-side only and is consumed by
# the /api/chat.js serverless function so the key NEVER ships to the browser.
# For Vercel production: add it in Project Settings → Environment Variables.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
